  }

#78 SubjectDirectoryAttributes (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #79 AttributeSetSupportedAttributes

#79 AttributeSetSupportedAttributes (PKIX-CommonTypes-2009) = AttributeSet{{ SupportedAttributes }}
  SEQUENCE {
    type: OBJECT IDENTIFIER (table(set#3 &id))
    values: SET (SIZE (1..MAX))  { size=1..MAX } OF open type ATTRIBUTE.&Type table(set#3 &Type @type)
  }

#80 BasicConstraints (PKIX1Implicit-2009)
  SEQUENCE {
    cA DEFAULT FALSE: BOOLEAN
    pathLenConstraint OPTIONAL: INTEGER (0..MAX)  { value=0..MAX }
  }

#81 NameConstraints (PKIX1Implicit-2009)
  SEQUENCE {
    permittedSubtrees OPTIONAL: [0] IMPLICIT -> #82 GeneralSubtrees  { size=1..MAX }
    excludedSubtrees OPTIONAL: [1] IMPLICIT -> #82 GeneralSubtrees  { size=1..MAX }
  }

#82 GeneralSubtrees (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #83 GeneralSubtree

#83 GeneralSubtree (PKIX1Implicit-2009)
  SEQUENCE {
    base: -> #45 GeneralName
    minimum DEFAULT 0: [0] IMPLICIT -> #84 BaseDistance  { value=0..MAX }
    maximum OPTIONAL: [1] IMPLICIT -> #84 BaseDistance  { value=0..MAX }
  }

#84 BaseDistance (PKIX1Implicit-2009)
  INTEGER (0..MAX)  { value=0..MAX }

#85 PolicyConstraints (PKIX1Implicit-2009)
  SEQUENCE {
