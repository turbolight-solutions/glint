  }

#68 PrivateKeyUsagePeriod (PKIX1Implicit-2009)
  SEQUENCE {
    notBefore OPTIONAL: [0] IMPLICIT GeneralizedTime
    notAfter OPTIONAL: [1] IMPLICIT GeneralizedTime
  } ((WITH COMPONENTS { ..., notBefore Present } | WITH COMPONENTS { ..., notAfter Present }))

#69 CertificatePolicies (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #70 PolicyInformation

#70 PolicyInformation (PKIX1Implicit-2009)
  SEQUENCE {
    policyIdentifier: -> #71 CertPolicyId
    policyQualifiers OPTIONAL: SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #72 PolicyQualifierInfo
  }

#71 CertPolicyId (PKIX1Implicit-2009)
  OBJECT IDENTIFIER

#72 PolicyQualifierInfo (PKIX1Implicit-2009)
  SEQUENCE {
    policyQualifierId: OBJECT IDENTIFIER (table(set#9 &id))
