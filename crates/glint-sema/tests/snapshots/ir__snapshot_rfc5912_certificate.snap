  }

#76 DisplayText (PKIX1Implicit-2009)
  CHOICE {
    ia5String: IA5String (SIZE (1..200))  { size=1..200 }
    visibleString: VisibleString (SIZE (1..200))  { size=1..200 }
    bmpString: BMPString (SIZE (1..200))  { size=1..200 }
    utf8String: UTF8String (SIZE (1..200))  { size=1..200 per: none }
  }

#77 PolicyMappings (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF SEQUENCE {
