  }

#86 SkipCerts (PKIX1Implicit-2009)
  INTEGER (0..MAX)  { value=0..MAX }

#87 ExtKeyUsageSyntax (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #88 KeyPurposeId

#88 KeyPurposeId (PKIX1Implicit-2009)
  OBJECT IDENTIFIER

#89 CRLDistributionPoints (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #90 DistributionPoint

#90 DistributionPoint (PKIX1Implicit-2009)
  SEQUENCE {
    distributionPoint OPTIONAL: [0] EXPLICIT -> #91 DistributionPointName
    reasons OPTIONAL: [1] IMPLICIT -> #92 ReasonFlags
    cRLIssuer OPTIONAL: [2] IMPLICIT -> #44 GeneralNames  { size=1..MAX }
  }

#91 DistributionPointName (PKIX1Implicit-2009)
  CHOICE {
    fullName: [0] IMPLICIT -> #44 GeneralNames  { size=1..MAX }
    nameRelativeToCRLIssuer: [1] IMPLICIT -> #15 RelativeDistinguishedName  { size=1..MAX }
  }

#92 ReasonFlags (PKIX1Implicit-2009)
  BIT STRING { unused(0), keyCompromise(1), cACompromise(2), affiliationChanged(3), superseded(4), cessationOfOperation(5), certificateHold(6), privilegeWithdrawn(7), aACompromise(8) }

#93 AuthorityInfoAccessSyntax (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #94 AccessDescription

#94 AccessDescription (PKIX1Implicit-2009)
  SEQUENCE {
    accessMethod: OBJECT IDENTIFIER
    accessLocation: -> #45 GeneralName
  }

#95 SubjectInfoAccessSyntax (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #94 AccessDescription

#96 ExtensionsCertExtensions (PKIX-CommonTypes-2009) = Extensions{{ CertExtensions }}
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #97 ExtensionCertExtensions

#97 ExtensionCertExtensions (PKIX-CommonTypes-2009) = Extension{{ { CertExtensions } }}
  SEQUENCE {
    extnID: OBJECT IDENTIFIER (table(set#7 &id))
    critical DEFAULT FALSE: BOOLEAN
    extnValue: OCTET STRING (CONTAINING open type EXTENSION.&ExtnType table(set#7 &ExtnType @extnID))
  }

#98 SIGNEDTBSCertificate (PKIX1Explicit-2009) = SIGNED{TBSCertificate}
  SEQUENCE {
    toBeSigned: -> #1 TBSCertificate
    algorithmIdentifier: SEQUENCE {
      algorithm: OBJECT IDENTIFIER (table(set#0 &id))
      parameters OPTIONAL: open type SIGNATURE-ALGORITHM.&Params table(set#0 &Params @algorithmIdentifier.algorithm)
    }
    signature: BIT STRING (CONTAINING open type SIGNATURE-ALGORITHM.&Value table(set#0 &Value @algorithmIdentifier.algorithm))
  }

set#0 SignatureAlgorithms (PKIX1Explicit-2009) SIGNATURE-ALGORITHM key &id ...
  sa-rsaWithMD2 oid 1.2.840.113549.1.1.2 (md2WithRSAEncryption)
    &Params: NULL
    &paramPresence = required
  sa-rsaWithMD5 oid 1.2.840.113549.1.1.4 (md5WithRSAEncryption)
    &Params: NULL
    &paramPresence = required
  sa-rsaWithSHA1 oid 1.2.840.113549.1.1.5 (sha1WithRSAEncryption)
    &Params: NULL
    &paramPresence = required
  sa-dsaWithSHA1 oid 1.2.840.10040.4.3 (dsa-with-sha1)
    &Params: NULL
    &Value: -> #5 DSA-Sig-Value
    &paramPresence = absent
  sa-ecdsaWithSHA1 oid 1.2.840.10045.4.1 (ecdsa-with-SHA1)
    &Params: NULL
    &Value: -> #6 ECDSA-Sig-Value
    &paramPresence = absent
  sa-dsaWithSHA224 oid 2.16.840.1.101.3.4.3.1 (dsa-with-sha224)
    &Params: NULL
    &Value: -> #5 DSA-Sig-Value
    &paramPresence = absent
  sa-dsaWithSHA256 oid 2.16.840.1.101.3.4.3.2 (dsa-with-sha256)
    &Params: NULL
    &Value: -> #5 DSA-Sig-Value
    &paramPresence = absent
  sa-ecdsaWithSHA224 oid 1.2.840.10045.4.3.1 (ecdsa-with-SHA224)
    &Params: NULL
    &Value: -> #6 ECDSA-Sig-Value
    &paramPresence = absent
  sa-ecdsaWithSHA256 oid 1.2.840.10045.4.3.2 (ecdsa-with-SHA256)
    &Params: NULL
    &Value: -> #6 ECDSA-Sig-Value
    &paramPresence = absent
  sa-ecdsaWithSHA384 oid 1.2.840.10045.4.3.3 (ecdsa-with-SHA384)
    &Params: NULL
    &Value: -> #6 ECDSA-Sig-Value
    &paramPresence = absent
  sa-ecdsaWithSHA512 oid 1.2.840.10045.4.3.4 (ecdsa-with-SHA512)
    &Params: NULL
    &Value: -> #6 ECDSA-Sig-Value
    &paramPresence = absent
  sa-rsaSSA-PSS oid 1.2.840.113549.1.1.10 (id-RSASSA-PSS)
    &Params: -> #7 RSASSA-PSS-params
    &paramPresence = required

set#1 HashAlgorithms (PKIX1-PSS-OAEP-Algorithms-2009) DIGEST-ALGORITHM key &id
  {inline} oid 1.3.14.3.2.26 (id-sha1)
    &Params: NULL
    &paramPresence = preferredPresent
  {inline} oid 2.16.840.1.101.3.4.2.4 (id-sha224)
    &Params: NULL
    &paramPresence = preferredPresent
  {inline} oid 2.16.840.1.101.3.4.2.1 (id-sha256)
    &Params: NULL
    &paramPresence = preferredPresent
  {inline} oid 2.16.840.1.101.3.4.2.2 (id-sha384)
    &Params: NULL
    &paramPresence = preferredPresent
  {inline} oid 2.16.840.1.101.3.4.2.3 (id-sha512)
    &Params: NULL
    &paramPresence = preferredPresent

set#2 PKCS1MGFAlgorithms (PKIX1-PSS-OAEP-Algorithms-2009) ALGORITHM key &id ...
  {inline} oid 1.2.840.113549.1.1.8 (id-mgf1)
