---
source: crates/glint-sema/tests/ir.rs
expression: "glint_ir::dump(&set)"
---
root #0

#0 Certificate (PKIX1Explicit-2009)
  -> #98 SIGNEDTBSCertificate

#1 TBSCertificate (PKIX1Explicit-2009)
  SEQUENCE { ...
    version DEFAULT 0: [0] EXPLICIT -> #2 Version
    serialNumber: -> #3 CertificateSerialNumber
    signature: -> #12 AlgorithmIdentifierSignatureAlgorithms
    issuer: -> #13 Name
    validity: -> #23 Validity
    subject: -> #13 Name
    subjectPublicKeyInfo: -> #25 SubjectPublicKeyInfo
    issuerUniqueID OPTIONAL +ext [[0 v2]]: [1] IMPLICIT -> #41 UniqueIdentifier
    subjectUniqueID OPTIONAL +ext [[0 v2]]: [2] IMPLICIT -> #41 UniqueIdentifier
    extensions OPTIONAL +ext [[1 v3]]: [3] EXPLICIT -> #96 ExtensionsCertExtensions  { size=1..MAX }
  }

#2 Version (PKIX1Explicit-2009)
  INTEGER { v1(0), v2(1), v3(2) }

#3 CertificateSerialNumber (PKIX1Explicit-2009)
  INTEGER

#4 ParamOptions (AlgorithmInformation-2009)
  ENUMERATED { required(0), preferredPresent(1), preferredAbsent(2), absent(3), inheritable(4), optional(5), ... }

#5 DSA-Sig-Value (PKIXAlgs-2009)
  SEQUENCE {
    r: INTEGER
    s: INTEGER
  }

#6 ECDSA-Sig-Value (PKIXAlgs-2009)
  SEQUENCE {
    r: INTEGER
    s: INTEGER
  }

#7 RSASSA-PSS-params (PKIX1-PSS-OAEP-Algorithms-2009)
  SEQUENCE {
    hashAlgorithm DEFAULT { algorithm oid 1.3.14.3.2.26, parameters NULL }: [0] EXPLICIT -> #8 HashAlgorithm
    maskGenAlgorithm DEFAULT { algorithm oid 1.2.840.113549.1.1.8, parameters { algorithm oid 1.3.14.3.2.26, parameters NULL } }: [1] EXPLICIT -> #10 MaskGenAlgorithm
    saltLength DEFAULT 20: [2] EXPLICIT INTEGER
    trailerField DEFAULT 1: [3] EXPLICIT INTEGER
  }

#8 HashAlgorithm (PKIX1-PSS-OAEP-Algorithms-2009)
  -> #9 AlgorithmIdentifierHashAlgorithms

#9 AlgorithmIdentifierHashAlgorithms (AlgorithmInformation-2009) = AlgorithmIdentifier{DIGEST-ALGORITHM, { HashAlgorithms }}
  SEQUENCE {
    algorithm: OBJECT IDENTIFIER (table(set#1 &id))
    parameters OPTIONAL: open type DIGEST-ALGORITHM.&Params table(set#1 &Params @algorithm)
  }

#10 MaskGenAlgorithm (PKIX1-PSS-OAEP-Algorithms-2009)
  -> #11 AlgorithmIdentifierPKCS1MGFAlgorithms

#11 AlgorithmIdentifierPKCS1MGFAlgorithms (AlgorithmInformation-2009) = AlgorithmIdentifier{ALGORITHM, { PKCS1MGFAlgorithms }}
  SEQUENCE {
    algorithm: OBJECT IDENTIFIER (table(set#2 &id))
    parameters OPTIONAL: open type ALGORITHM.&Params table(set#2 &Params @algorithm)
  }

#12 AlgorithmIdentifierSignatureAlgorithms (AlgorithmInformation-2009) = AlgorithmIdentifier{SIGNATURE-ALGORITHM, { SignatureAlgorithms }}
  SEQUENCE {
    algorithm: OBJECT IDENTIFIER (table(set#0 &id))
    parameters OPTIONAL: open type SIGNATURE-ALGORITHM.&Params table(set#0 &Params @algorithm)
  }

#13 Name (PKIX1Explicit-2009)
  CHOICE {
    rdnSequence: -> #14 RDNSequence
  }

#14 RDNSequence (PKIX1Explicit-2009)
  SEQUENCE OF -> #15 RelativeDistinguishedName  { size=1..MAX }

#15 RelativeDistinguishedName (PKIX1Explicit-2009)
  SET (SIZE (1..MAX))  { size=1..MAX } OF -> #22 SingleAttributeSupportedAttributes

#16 X520name (PKIX1Explicit-2009)
  -> #17 DirectoryStringUbName

#17 DirectoryStringUbName (PKIX1Explicit-2009) = DirectoryString{ub-name}
  CHOICE {
    teletexString: TeletexString (SIZE (1..32768))  { size=1..32768 per: none }
    printableString: PrintableString (SIZE (1..32768))  { size=1..32768 }
    bmpString: BMPString (SIZE (1..32768))  { size=1..32768 }
    universalString: UniversalString (SIZE (1..32768))  { size=1..32768 }
    uTF8String: UTF8String (SIZE (1..32768))  { size=1..32768 per: none }
  }

#18 X520CommonName (PKIX1Explicit-2009)
  -> #19 DirectoryStringUbCommonName

#19 DirectoryStringUbCommonName (PKIX1Explicit-2009) = DirectoryString{ub-common-name}
  CHOICE {
    teletexString: TeletexString (SIZE (1..64))  { size=1..64 per: none }
    printableString: PrintableString (SIZE (1..64))  { size=1..64 }
    bmpString: BMPString (SIZE (1..64))  { size=1..64 }
    universalString: UniversalString (SIZE (1..64))  { size=1..64 }
    uTF8String: UTF8String (SIZE (1..64))  { size=1..64 per: none }
  }

#20 X520LocalityName (PKIX1Explicit-2009)
  -> #21 DirectoryStringUbLocalityName

#21 DirectoryStringUbLocalityName (PKIX1Explicit-2009) = DirectoryString{ub-locality-name}
  CHOICE {
    teletexString: TeletexString (SIZE (1..128))  { size=1..128 per: none }
    printableString: PrintableString (SIZE (1..128))  { size=1..128 }
    bmpString: BMPString (SIZE (1..128))  { size=1..128 }
    universalString: UniversalString (SIZE (1..128))  { size=1..128 }
    uTF8String: UTF8String (SIZE (1..128))  { size=1..128 per: none }
  }

#22 SingleAttributeSupportedAttributes (PKIX-CommonTypes-2009) = SingleAttribute{{ SupportedAttributes }}
  SEQUENCE {
    type: OBJECT IDENTIFIER (table(set#3 &id))
    value: open type ATTRIBUTE.&Type table(set#3 &Type @type)
  }

#23 Validity (PKIX1Explicit-2009)
  SEQUENCE {
    notBefore: -> #24 Time
