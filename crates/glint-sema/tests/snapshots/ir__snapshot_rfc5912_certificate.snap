#35 ECParameters (PKIXAlgs-2009)
  CHOICE {
    namedCurve: OBJECT IDENTIFIER (table(set#5 &id))
  }

#36 RSAES-OAEP-params (PKIX1-PSS-OAEP-Algorithms-2009)
  SEQUENCE {
    hashFunc DEFAULT { algorithm oid 1.3.14.3.2.26, parameters NULL }: [0] EXPLICIT -> #8 HashAlgorithm
    maskGenFunc DEFAULT { algorithm oid 1.2.840.113549.1.1.8, parameters { algorithm oid 1.3.14.3.2.26, parameters NULL } }: [1] EXPLICIT -> #10 MaskGenAlgorithm
    pSourceFunc DEFAULT { algorithm oid 1.2.840.113549.1.1.9, parameters ''H }: [2] EXPLICIT -> #37 PSourceAlgorithm
  }

#37 PSourceAlgorithm (PKIX1-PSS-OAEP-Algorithms-2009)
  -> #39 AlgorithmIdentifierPSSSourceAlgorithms

#38 EncodingParameters (PKIX1-PSS-OAEP-Algorithms-2009)
  OCTET STRING (SIZE (0..MAX))  { size=0..MAX }

#39 AlgorithmIdentifierPSSSourceAlgorithms (AlgorithmInformation-2009) = AlgorithmIdentifier{ALGORITHM, { PSS-SourceAlgorithms }}
  SEQUENCE {
    algorithm: OBJECT IDENTIFIER (table(set#6 &id))
    parameters OPTIONAL: open type ALGORITHM.&Params table(set#6 &Params @algorithm)
  }

#40 AlgorithmIdentifierPublicKeyAlgorithms (AlgorithmInformation-2009) = AlgorithmIdentifier{PUBLIC-KEY, { PublicKeyAlgorithms }}
  SEQUENCE {
    algorithm: OBJECT IDENTIFIER (table(set#4 &id))
    parameters OPTIONAL: open type PUBLIC-KEY.&Params table(set#4 &Params @algorithm)
  }

#41 UniqueIdentifier (PKIX1Explicit-2009)
  BIT STRING

#42 AuthorityKeyIdentifier (PKIX1Implicit-2009)
  SEQUENCE {
    keyIdentifier OPTIONAL: [0] IMPLICIT -> #43 KeyIdentifier
    authorityCertIssuer OPTIONAL: [1] IMPLICIT -> #44 GeneralNames  { size=1..MAX }
    authorityCertSerialNumber OPTIONAL: [2] IMPLICIT -> #3 CertificateSerialNumber
  } ((WITH COMPONENTS { ..., authorityCertIssuer Present, authorityCertSerialNumber Present } | WITH COMPONENTS { ..., authorityCertIssuer Absent, authorityCertSerialNumber Absent }))

#43 KeyIdentifier (PKIX1Implicit-2009)
  OCTET STRING

#44 GeneralNames (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #45 GeneralName

#45 GeneralName (PKIX1Implicit-2009)
  CHOICE {
    otherName: [0] IMPLICIT [UNIVERSAL 8] IMPLICIT SEQUENCE {
      type-id: OBJECT IDENTIFIER
      value: [0] EXPLICIT open type OTHER-NAME.&Type
    }
    rfc822Name: [1] IMPLICIT IA5String
    dNSName: [2] IMPLICIT IA5String
    x400Address: [3] IMPLICIT -> #46 ORAddress
    directoryName: [4] EXPLICIT -> #13 Name
    ediPartyName: [5] IMPLICIT -> #67 EDIPartyName
    uniformResourceIdentifier: [6] IMPLICIT IA5String
    iPAddress: [7] IMPLICIT OCTET STRING
    registeredID: [8] IMPLICIT OBJECT IDENTIFIER
  }

#46 ORAddress (PKIX-X400Address-2009)
  SEQUENCE {
    built-in-standard-attributes: -> #47 BuiltInStandardAttributes
    built-in-domain-defined-attributes OPTIONAL: -> #59 BuiltInDomainDefinedAttributes  { size=1..4 }
    extension-attributes OPTIONAL: -> #61 ExtensionAttributes  { size=1..256 }
  }

#47 BuiltInStandardAttributes (PKIX-X400Address-2009)
  SEQUENCE {
    country-name OPTIONAL: -> #48 CountryName
    administration-domain-name OPTIONAL: -> #49 AdministrationDomainName
    network-address OPTIONAL: [0] IMPLICIT -> #50 NetworkAddress  { size=1..16 }
    terminal-identifier OPTIONAL: [1] IMPLICIT -> #52 TerminalIdentifier  { size=1..24 }
    private-domain-name OPTIONAL: [2] EXPLICIT -> #53 PrivateDomainName
    organization-name OPTIONAL: [3] IMPLICIT -> #54 OrganizationName  { size=1..64 }
    numeric-user-identifier OPTIONAL: [4] IMPLICIT -> #55 NumericUserIdentifier  { size=1..32 }
    personal-name OPTIONAL: [5] IMPLICIT -> #56 PersonalName
    organizational-unit-names OPTIONAL: [6] IMPLICIT -> #57 OrganizationalUnitNames  { size=1..4 }
  }

#48 CountryName (PKIX-X400Address-2009)
  [APPLICATION 1] EXPLICIT CHOICE {
    x121-dcc-code: NumericString (SIZE (3))  { size=3..3 }
    iso-3166-alpha2-code: PrintableString (SIZE (2))  { size=2..2 }
  }

#49 AdministrationDomainName (PKIX-X400Address-2009)
  [APPLICATION 2] EXPLICIT CHOICE {
    numeric: NumericString (SIZE (0..16))  { size=0..16 }
    printable: PrintableString (SIZE (0..16))  { size=0..16 }
  }

#50 NetworkAddress (PKIX-X400Address-2009)
  -> #51 X121Address  { size=1..16 }

#51 X121Address (PKIX-X400Address-2009)
  NumericString (SIZE (1..16))  { size=1..16 }

#52 TerminalIdentifier (PKIX-X400Address-2009)
  PrintableString (SIZE (1..24))  { size=1..24 }

#53 PrivateDomainName (PKIX-X400Address-2009)
  CHOICE {
    numeric: NumericString (SIZE (1..16))  { size=1..16 }
    printable: PrintableString (SIZE (1..16))  { size=1..16 }
  }

#54 OrganizationName (PKIX-X400Address-2009)
  PrintableString (SIZE (1..64))  { size=1..64 }

#55 NumericUserIdentifier (PKIX-X400Address-2009)
  NumericString (SIZE (1..32))  { size=1..32 }

#56 PersonalName (PKIX-X400Address-2009)
  SET {
    surname: [0] IMPLICIT PrintableString (SIZE (1..40))  { size=1..40 }
    given-name OPTIONAL: [1] IMPLICIT PrintableString (SIZE (1..16))  { size=1..16 }
    initials OPTIONAL: [2] IMPLICIT PrintableString (SIZE (1..5))  { size=1..5 }
    generation-qualifier OPTIONAL: [3] IMPLICIT PrintableString (SIZE (1..3))  { size=1..3 }
  }

#57 OrganizationalUnitNames (PKIX-X400Address-2009)
  SEQUENCE (SIZE (1..4))  { size=1..4 } OF -> #58 OrganizationalUnitName  { size=1..32 }

#58 OrganizationalUnitName (PKIX-X400Address-2009)
  PrintableString (SIZE (1..32))  { size=1..32 }

#59 BuiltInDomainDefinedAttributes (PKIX-X400Address-2009)
  SEQUENCE (SIZE (1..4))  { size=1..4 } OF -> #60 BuiltInDomainDefinedAttribute

#60 BuiltInDomainDefinedAttribute (PKIX-X400Address-2009)
  SEQUENCE {
    type: PrintableString (SIZE (1..8))  { size=1..8 }
