    sSelector OPTIONAL: [1] EXPLICIT OCTET STRING
    tSelector OPTIONAL: [2] EXPLICIT OCTET STRING
    nAddresses: [3] EXPLICIT SET (SIZE (1..MAX))  { size=1..MAX } OF OCTET STRING
  }

#66 TeletexDomainDefinedAttribute (PKIX-X400Address-2009)
