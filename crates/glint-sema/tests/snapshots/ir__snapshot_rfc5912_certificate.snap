  }

#61 ExtensionAttributes (PKIX-X400Address-2009)
  SET (SIZE (1..256))  { size=1..256 } OF -> #62 ExtensionAttribute

#62 ExtensionAttribute (PKIX-X400Address-2009)
  SEQUENCE {
