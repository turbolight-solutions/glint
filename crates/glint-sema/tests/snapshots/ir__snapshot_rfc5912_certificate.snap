  }

#63 TeletexOrganizationalUnitName (PKIX-X400Address-2009)
  TeletexString (SIZE (1..32))  { size=1..32 per: none }

#64 PDSParameter (PKIX-X400Address-2009)
  SET {
    printable-string OPTIONAL: PrintableString (SIZE (1..30))  { size=1..30 }
