    parameters OPTIONAL: open type DIGEST-ALGORITHM.&Params table(set#1 &Params @algorithm)
  }

#5 EncapsulatedContentInfo (CryptographicMessageSyntax-2010)
  SEQUENCE {
    eContentType: OBJECT IDENTIFIER (table(set#0 &id))
    eContent OPTIONAL: [0] EXPLICIT OCTET STRING (CONTAINING open type CONTENT-TYPE.&Type table(set#0 &Type @eContentType))
  }

#6 CertificateSet (CryptographicMessageSyntax-2010)
  SET OF -> #7 CertificateChoices

#7 CertificateChoices (CryptographicMessageSyntax-2010)
  CHOICE { ...
    certificate: -> #8 Certificate
    extendedCertificate: [0] IMPLICIT -> #107 ExtendedCertificate
    v1AttrCert +ext [[0 v3]]: [1] IMPLICIT -> #114 AttributeCertificateV1
    v2AttrCert +ext [[1 v4]]: [2] IMPLICIT -> #124 AttributeCertificateV2
    other +ext [[2 v5]]: [3] IMPLICIT -> #247 OtherCertificateFormat
  }

#8 Certificate (PKIX1Explicit-2009)
  -> #106 SIGNEDTBSCertificate

#9 TBSCertificate (PKIX1Explicit-2009)
  SEQUENCE { ...
    version DEFAULT 0: [0] EXPLICIT -> #10 Version
    serialNumber: -> #11 CertificateSerialNumber
    signature: -> #20 AlgorithmIdentifierSignatureAlgorithms
    issuer: -> #21 Name
    validity: -> #31 Validity
    subject: -> #21 Name
    subjectPublicKeyInfo: -> #33 SubjectPublicKeyInfo
    issuerUniqueID OPTIONAL +ext [[0 v2]]: [1] IMPLICIT -> #49 UniqueIdentifier
    subjectUniqueID OPTIONAL +ext [[0 v2]]: [2] IMPLICIT -> #49 UniqueIdentifier
    extensions OPTIONAL +ext [[1 v3]]: [3] EXPLICIT -> #104 ExtensionsCertExtensions  { size=1..MAX }
  }

#10 Version (PKIX1Explicit-2009)
