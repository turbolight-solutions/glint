root #0

#0 ContentInfo (CryptographicMessageSyntax-2010)
  SEQUENCE {
    contentType: OBJECT IDENTIFIER (table(set#0 &id))
    content: [0] EXPLICIT open type CONTENT-TYPE.&Type table(set#0 &Type @contentType)
  }

#1 SignedData (CryptographicMessageSyntax-2010)
  SEQUENCE {
    version: -> #2 CMSVersion
    digestAlgorithms: SET OF -> #3 DigestAlgorithmIdentifier
    encapContentInfo: -> #5 EncapsulatedContentInfo
    certificates OPTIONAL: [0] IMPLICIT -> #6 CertificateSet
    crls OPTIONAL: [1] IMPLICIT -> #248 RevocationInfoChoices
    signerInfos: -> #251 SignerInfos
  }

#2 CMSVersion (CryptographicMessageSyntax-2010)
