#1 OCSPResponseStatus (OCSP-2013-08)
  ENUMERATED { successful(0), malformedRequest(1), internalError(2), tryLater(3), sigRequired(5), unauthorized(6) }

#2 ResponseBytes (OCSP-2013-08)
