#113 DistributionPointName (PKIX1Implicit-2009)
  CHOICE {
    fullName: [0] IMPLICIT -> #28 GeneralNames  { size=1..MAX }
    nameRelativeToCRLIssuer: [1] IMPLICIT -> #9 RelativeDistinguishedName  { size=1..MAX }
  }

#114 ReasonFlags (PKIX1Implicit-2009)
  BIT STRING { unused(0), keyCompromise(1), cACompromise(2), affiliationChanged(3), superseded(4), cessationOfOperation(5), certificateHold(6), privilegeWithdrawn(7), aACompromise(8) }

#115 AuthorityInfoAccessSyntax (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #116 AccessDescription

#116 AccessDescription (PKIX1Implicit-2009)
  SEQUENCE {
    accessMethod: OBJECT IDENTIFIER
    accessLocation: -> #29 GeneralName
  }

#117 SubjectInfoAccessSyntax (PKIX1Implicit-2009)
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #116 AccessDescription

#118 ExtensionsCertExtensions (PKIX-CommonTypes-2009) = Extensions{{ CertExtensions }}
  SEQUENCE (SIZE (1..MAX))  { size=1..MAX } OF -> #119 ExtensionCertExtensions

#119 ExtensionCertExtensions (PKIX-CommonTypes-2009) = Extension{{ { CertExtensions } }}
  SEQUENCE {
    extnID: OBJECT IDENTIFIER (table(set#13 &id))
    critical DEFAULT FALSE: BOOLEAN
    extnValue: OCTET STRING (CONTAINING open type EXTENSION.&ExtnType table(set#13 &ExtnType @extnID))
  }

#120 SIGNEDTBSCertificate (PKIX1Explicit-2009) = SIGNED{TBSCertificate}
  SEQUENCE {
    toBeSigned: -> #60 TBSCertificate
    algorithmIdentifier: SEQUENCE {
      algorithm: OBJECT IDENTIFIER (table(set#7 &id))
      parameters OPTIONAL: open type SIGNATURE-ALGORITHM.&Params table(set#7 &Params @algorithmIdentifier.algorithm)
    }
    signature: BIT STRING (CONTAINING open type SIGNATURE-ALGORITHM.&Value table(set#7 &Value @algorithmIdentifier.algorithm))
  }

