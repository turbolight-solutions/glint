[Unit]
Description=Glint web service (container)
Documentation=https://github.com/turbolight-solutions/glint
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5

# Clear any container left over from a crash, then refresh the image. A failed pull (registry down)
# must not keep an already-pulled image from starting, hence the leading "-".
ExecStartPre=-/usr/bin/docker rm -f glint
ExecStartPre=-/usr/bin/docker pull ghcr.io/turbolight-solutions/glint:edge

# Runs in the foreground so systemd supervises it and journald collects the JSON logs.
# Published on loopback only; nginx on :10443 is the way in. The image is stateless, so the
# root filesystem can be read-only.
ExecStart=/usr/bin/docker run --rm --name glint \
    --publish 127.0.0.1:8080:8080 \
    --env GLINT_TRUST_PROXY=true \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit 256 \
    ghcr.io/turbolight-solutions/glint:edge

ExecStop=/usr/bin/docker stop --time 10 glint
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
